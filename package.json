{
	"name": "learn-cloud",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:generated": "svelte-check --tsconfig tmp/config/tsconfig.generated.json",
		"check:wip": "bash src/bash/check-wip.sh",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"format:fix": "prettier --write",
		"lint:fix": "eslint --fix",
		"format:check": "prettier --check",
		"lint:check": "eslint",
		"validate:scripts": "prettier --write \"src/scripts/**/*.ts\" && eslint --fix \"src/scripts/**/*.ts\"",
		"generate-content-menu": "npx tsx src/scripts/content-menu-generator.ts",
		"scaffold-content": "tsx src/scripts/content-scaffolding.ts",
		"validate-mermaid": "npx tsx src/scripts/mermaid-validator.ts",
		"validate-generated": "prettier --write \"src/data/book/\" && eslint --fix \"src/data/book/\"",
		"validate-menu-file": "prettier --write \"src/data/generated/content-menu.ts\" && eslint --fix \"src/data/generated/content-menu.ts\"",
		"test": "vitest",
		"test:run": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.515.0",
		"@mermaid-js/mermaid-cli": "^11.10.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"bits-ui": "^2.9.9",
		"clsx": "^2.1.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.2.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"ts-morph": "^27.0.0",
		"tsx": "^4.20.5",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"*.{js,ts,svelte,css,md,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"puppeteer"
		]
	},
	"dependencies": {
		"lucide-svelte": "^0.544.0",
		"mermaid": "^11.11.0",
		"shiki": "^3.12.2"
	}
}
