{
	"name": "learn-cloud",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:generated": "svelte-check --tsconfig tmp/config/tsconfig.generated.json",
		"check:wip": "bash src/bash/check-wip.sh",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint --cache --cache-location ./tmp/cache/.eslintcache .",
		"format:fix": "prettier --write",
		"lint:fix": "eslint --cache --cache-location ./tmp/cache/.eslintcache --fix",
		"format:check": "prettier --check",
		"lint:check": "eslint --cache --cache-location ./tmp/cache/.eslintcache",
		"validate:scripts": "prettier --write \"src/scripts/**/*.ts\" && eslint --fix \"src/scripts/**/*.ts\"",
		"generate-menu": "npx tsx src/scripts/generate-menu.ts",
		"generate-flatnav": "npx tsx src/scripts/flatnav-generator.ts",
		"manage-content": "tsx src/scripts/manage-content.ts",
		"manage-content:create": "tsx src/scripts/manage-content.ts create",
		"manage-content:list": "tsx src/scripts/manage-content.ts list",
		"manage-content:update": "tsx src/scripts/manage-content.ts update",
		"manage-content:delete": "tsx src/scripts/manage-content.ts delete",
		"manage-content:validate": "tsx src/scripts/manage-content.ts validate",
		"scaffold:generate": "tsx src/scripts/generate-scaffold.ts scaffold",
		"validate-mermaid": "npx tsx src/scripts/mermaid-validator.ts",
		"validate-theme": "npx tsx src/scripts/validate-theme.ts",
		"validate-theme:wip": "npx tsx src/scripts/validate-theme.ts --wip",
		"generate-search-index": "npm run generate-search-index-dev",
		"generate-search-index-dev": "npx tsx src/scripts/generate-search-index.ts dev",
		"generate-search-index-prod": "npx tsx src/scripts/generate-search-index.ts prod",
		"generate-schemas": "npx tsx src/scripts/generate-schemas.ts",
		"validate-content": "npm run validate-mermaid && npm run generate-menu && npm run generate-search-index-dev",
		"validate-content:prod": "npm run validate-mermaid && npm run generate-menu && npm run generate-search-index-prod",
		"validate-generated": "prettier --write \"src/data/book/\" && eslint --fix \"src/data/book/\"",
		"test": "vitest",
		"test:run": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"workflow:metadata": "make check-wip && pnpm run generate-menu && pnpm run scaffold:generate && pnpm run generate-flatnav && pnpm run generate-search-index && pnpm run format && pnpm run lint",
		"workflow:content": "make check-wip && pnpm run generate-flatnav && pnpm run generate-search-index && pnpm run format && pnpm run lint",
		"workflow:full-validation": "make check-wip && pnpm run format && pnpm run lint && pnpm run test && pnpm run check"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.544.0",
		"@mermaid-js/mermaid-cli": "^11.10.1",
		"@opentelemetry/api": "^1.9.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.48.4",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/jsdom": "^21.1.7",
		"@types/lunr": "^2.3.7",
		"@types/node": "^22",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"ajv": "^8.17.1",
		"ajv-cli": "^5.0.0",
		"ajv-formats": "^3.0.1",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.13.0",
		"glob": "^11.0.3",
		"globals": "^16.0.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.2.0",
		"lunr": "^2.3.9",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.43.2",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.0.0",
		"ts-morph": "^27.0.0",
		"tsx": "^4.20.5",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"*.{js,ts,svelte,css,md,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"puppeteer"
		]
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"commander": "^14.0.1",
		"lucide-svelte": "^0.544.0",
		"mermaid": "^11.11.0",
		"shiki": "^3.12.2",
		"zod": "^4.1.11"
	}
}
