# Dependencies
# These are installed by package managers and should not be in version control.
/node_modules
/bower_components

# Build artifacts and Output
# These are the output of the build process and are generated from the source code.
/build
/dist
/out
.output
.vercel
.netlify
.wrangler
/.svelte-kit

# Log files
# These can be verbose and specific to a user's machine.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
# Note: .env contains project configuration (not secrets) and should be committed
# Only user-specific and sensitive .env files are ignored
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.test

# IDE and editor directories
# These are user-specific settings and should not be shared.
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
# These are created by the operating system and are not part of the project.
.DS_Store
Thumbs.db

# Temporary files and build artifacts
# HTML validation backups, logs, and other temporary files
tmp/
*.backup*

# Python cache files
# These improve performance but are machine-specific
__pycache__/
*.py[cod]
*$py.class
tmp/pycache/

# Python virtual environment
.venv/

# Vite specific files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Content scaffolds for E2E testing (TECHNICAL DEBT - TASK 9)
# Only unit01 chapters 00-01 are versioned for CI/CD until content migration complete
# TODO: Remove these exceptions after TASK 9 (Content Migration) is finished
# Reference: PLAN-TODO-FEATURES.md TASK 9

# Ignore all files in book/ and its subdirectories
src/data/book/**/*

# But track these specific files
!src/data/book/overview.ts
!src/data/book/unit01/
!src/data/book/unit01/01_00_*.ts
!src/data/book/unit01/01_01_*.ts
