{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022"],
		"outDir": "./scripts",
		"rootDir": "./scripts",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"types": ["node"]
	},
	"include": ["scripts/**/*.ts"],
	"exclude": ["node_modules", "scripts/**/*.js"]
}
